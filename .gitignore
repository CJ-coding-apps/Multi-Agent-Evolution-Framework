# Dependencies
node_modules/

# Build output
packages/*/dist/
dist/
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Turbo
.turbo/

# Environment & secrets
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# MAF runtime state — keep .maf config templates (policy.yaml, roles.yaml,
# config.yaml, prompts/) and the committed default harness that offline goldens
# evaluate on a fresh clone; ignore everything a run produces locally.
.maf/runs/
.maf/cache/
.maf/memory.kuzu
.maf/lcm.db
.maf/lcm.db-wal
.maf/lcm.db-shm
.maf/transcripts/
.maf/attestations/
.maf/harnesses/*
!.maf/harnesses/default-*.json
.maf/goldens/results/
.maf/evolve/
.maf/approvals/
