{
  "name": "maf",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "kuzu"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:test-scripts": "node scripts/check-test-scripts.mjs",
    "check:build-output": "node scripts/check-build-output.mjs",
    "check:workspace-deps": "node scripts/check-workspace-deps.mjs",
    "check:doc-refs": "node scripts/check-doc-refs.mjs",
    "check:package": "node scripts/pack-check.mjs",
    "pack:package": "node scripts/pack-package.mjs",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
